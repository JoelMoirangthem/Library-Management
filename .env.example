# Dummy mode (the default when running locally): runs entirely in the browser with fake data. No keys needed.
# A production build ignores a missing value and uses the real backend; only an explicit 'mock' gives fake data.
VITE_DATA_MODE=mock

# Later, for Supabase mode: copy to .env and fill in from Supabase: Project Settings -> API.
# Only the public anon key goes here. Never put the service_role key in this app.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# The UPI ID owners pay the plan fee to (name@bank). Required in Supabase mode; there is no default.
# In dummy mode, leave it blank and the app shows the fake demo@upi.
VITE_UPI_ID=

