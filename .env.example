# Dummy mode (the default when running locally): runs entirely in the browser with fake data. No keys needed.
# A production build ignores a missing value and uses the real backend; only an explicit 'mock' gives fake data.
VITE_DATA_MODE=mock

# Later, for Supabase mode: copy to .env and fill in from Supabase: Project Settings -> API.
# Only the public anon key goes here. Never put the service_role key in this app.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# The UPI ID owners pay the plan fee to (name@bank). Required in Supabase mode; there is no default.
# In dummy mode, leave it blank and the app shows the fake demo@upi.
VITE_UPI_ID=

# The support email shown in the footer, legal pages and account page.
# Optional: if left blank the app uses its built-in default address.
VITE_SUPPORT_EMAIL=

# --- Admin tools only (migrations and checks). NOT used by the website and NOT needed on the host. ---
# The database password, as plain text (do not percent-encode it; the tool does that). Keep it in .env only, never in render.yaml.
# These names deliberately do not start with VITE_, so they are never put into the website that visitors download.
SUPABASE_DB_PASSWORD=
# Only if your project is in another region than Sydney: the pooler host shown in Supabase under Connect.
# SUPABASE_DB_HOST=
