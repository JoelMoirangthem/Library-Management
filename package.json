{
  "name": "studyseat",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "db:push": "node --env-file=.env scripts/db.mjs push",
    "db:query": "node --env-file=.env scripts/db.mjs query",
    "security:check": "node --env-file=.env scripts/securityCheck.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@supabase/supabase-js": "2.118.0",
    "lucide-react": "1.59.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "7.18.4",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "5.0.5"
  }
